# Database - Get from Vercel > Neon integration
# Format: postgres://user:pass@host.neon.tech/db?sslmode=require
NEON_URL=

# Admin panel password (>= 16 chars; login is disabled otherwise)
ADMIN_PASSWORD=

# HMAC key for admin session cookies (>= 32 chars, separate from ADMIN_PASSWORD)
AUTH_SECRET=generate-with-openssl-rand-hex-32
